{
  "name": "rtccourrier-saas",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "wrangler pages deploy dist --project-name=rtccourrier",
    "d1:init": "wrangler d1 execute my-db --local --file=./schema.sql && wrangler d1 execute my-db --local --file=./seed.sql",
    "d1:init:remote": "wrangler d1 execute my-db --remote --file=./schema.sql && wrangler d1 execute my-db --remote --file=./seed.sql"
  },
  "dependencies": {
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.1",
    "wrangler": "^3.91.0"
  }
}
